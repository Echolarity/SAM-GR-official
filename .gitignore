# =============================================================================
# SAM-GR .gitignore
# Source code, configs, docs and small metadata stay tracked; everything below
# is regenerable, temporary, machine-specific, or a build/experiment artifact.
# =============================================================================

# ------------------------------------------------------------------
# Python bytecode / build / packaging
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------
# Virtual environments / tooling
# ------------------------------------------------------------------
.env
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
.python-version
uv.lock
.pdm.toml
conda-meta/

# ------------------------------------------------------------------
# Test / lint / type-check caches
# ------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/
.nosetests.xml
coverage.xml
*.cover
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.cython_debug/
.ruff_cache/

# ------------------------------------------------------------------
# IDE / OS
# ------------------------------------------------------------------
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject
.ipynb_checkpoints
.DS_Store
Thumbs.db
*.manifest
*.spec
*.swp
*~

# ------------------------------------------------------------------
# Logs / runtime state
# ------------------------------------------------------------------
logs/
nohup_logs/
nohup.out
*.log
*.pid
*.sid
*.meta
*.args
.history/
temp/
tmp/
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------
# Experiment tracking
# ------------------------------------------------------------------
wandb/
swanlog/
hf_cache/
ms_cache/
om_cache/
llamaboard_cache/
llamaboard_config/
tensorboard/

# ------------------------------------------------------------------
# Model checkpoints & training outputs
# ------------------------------------------------------------------
saves/
newsaves/
output/
outputs/
results/
results*/
runs/
rl_outputs/
rq_output/
sasrec_models/
experiments_new/
experiments_strong/
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.onnx
generated_predictions.jsonl
predictions_score.json
trainer_state.json
optimizer.pt
scheduler.pt

# ------------------------------------------------------------------
# Embeddings & generated SID artifacts
# ------------------------------------------------------------------
*.npy
*.npz
*.index.json

# ------------------------------------------------------------------
# Datasets & raw data (regenerated/downloaded via scripts)
# ------------------------------------------------------------------
data/*.jsonl
data/*.jsonl.gz
data/*.gz
data/*.zip
data/*.tar
data/*.tar.gz
data/*.manifest.json
data/meta_*.jsonl
data/meta_*.json
data/Amazon/
data/Amazon18/
data/amazon18/
data/Books/
data/Books_images/
data/*_images/
data/Books_*.json
data/Books_sub_*.txt
data/*_filtered.json
data/*/rl/
data/*/sft/
data/*/*_bak*/
data/*/*.bak*/
data/peek_samples.py
data/*_core.jsonl.gz
data/*_strict*core.jsonl.gz
data/*_images_todo.jsonl
data/*_10core_items.txt
data/*_10core.jsonl.gz

# Generated SID vocabularies / mappings inside dataset dirs
data/*/id2sid.json
data/*/new_tokens.json
data/*/*.index.json

# ------------------------------------------------------------------
# Analysis artifacts (scripts and reports remain tracked)
# ------------------------------------------------------------------
analysis/**/results/
analysis/**/figures/
analysis/**/logs/
analysis/**/checkpoints/
analysis/**/embeddings/
analysis/**/tiger_data/
analysis/**/tiger_data_out/
analysis/**/workspaces/
analysis/**/fusion_evidence_bundle/
analysis/**/*.tar.gz
analysis/**/*.png
analysis/**/*.svg
analysis/**/*.pdf

# ------------------------------------------------------------------
# Misc archives / compressed artifacts
# ------------------------------------------------------------------
*.tar.gz
*.zip
